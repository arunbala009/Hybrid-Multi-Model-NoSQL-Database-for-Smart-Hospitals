# ==============================================================================
# Hybrid Multi-Model NoSQL Database for Smart Hospitals - Environment Config Template
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit or expose your real .env file.
# ==============================================================================

# Neo4j AuraDB / Local Neo4j Configuration
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-secure-password
NEO4J_DATABASE=neo4j

# Backend API Configuration
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=true

# Security & Demo Seeding Token
DEMO_SEED_TOKEN=hospital-academic-demo-key-2026
